{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2024"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "preserveSymlinks": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "files": [
    "src/index.ts",
    "src/service.ts",
    "src/status.ts",
    "src/types.ts",
    "src/log.ts",
    "src/commit-message.ts",
    "src/commit-message-settings.ts",
    "src/remote/types.ts",
    "src/remote/credentials.ts",
    "src/remote/errors.ts",
    "src/remote/feature.ts",
    "src/remote/settings.ts",
    "src/remote/grant.ts",
    "src/remote/instances.ts",
    "src/remote/gitlab-grant.ts",
    "src/remote/gitlab-auth.ts",
    "src/remote/http.ts",
    "src/remote/probe.ts",
    "src/remote/auth.ts",
    "src/remote/provider.ts",
    "src/remote/github-model.ts",
    "src/remote/github.ts",
    "src/remote/git.ts",
    "src/remote/runtime.ts"
  ]
}
